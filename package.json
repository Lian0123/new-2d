{
  "name": "mio-2d-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,studio \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test src/core/*.test.ts server/*.test.ts",
    "build:runtime": "tsx scripts/build-runtime.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^26.0.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.0",
    "@types/archiver": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^8.1.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "esbuild": "^0.28.0",
    "concurrently": "^9.2.0",
    "sharp": "^0.35.5",
    "@playwright/test": "^1.55.0"
  },
  "engines": { "node": ">=22.12.0" }
}
